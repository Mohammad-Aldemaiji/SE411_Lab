<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>edu.psu.se411</groupId>
  <artifactId>Lab04-Maven-Intro</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <!-- Ex 2.1a: project information -->
  <name>Lab04 Maven Intro</name>
  <description>SE411 Lab 04: a Maven project that imports JavaFX as a dependency, runs a basic JavaFX window with the javafx-maven-plugin, and generates a documentation website with the Maven Site Plugin.</description>
  <url>https://github.com/Mohammad-Aldemaiji/SE411_Lab</url>

  <!-- Ex 2.1b: license -->
  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <!-- Ex 2.1c: organization -->
  <organization>
    <name>SE411-Tech-Company</name>
    <url>https://github.com/Mohammad-Aldemaiji</url>
  </organization>

  <!-- Ex 2.1d: developers -->
  <developers>
    <developer>
      <name>Mohammad Aldemaiji</name>
      <email>mohammed.demaiji@gmail.com</email>
      <organization>Prince Sultan University</organization>
      <roles>
        <role>Developer</role>
      </roles>
    </developer>
  </developers>

  <!-- Extra info shown on the generated site (Ex 2.4) -->
  <scm>
    <url>https://github.com/Mohammad-Aldemaiji/SE411_Lab</url>
    <connection>scm:git:https://github.com/Mohammad-Aldemaiji/SE411_Lab.git</connection>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/Mohammad-Aldemaiji/SE411_Lab/issues</url>
  </issueManagement>

  <properties>
    <!-- JavaFX 23 requires JDK 21 or newer -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- Ex 1.3: JavaFX dependency -->
  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>23</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Ex 1.3: JavaFX plugin providing the javafx:run goal -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>edu.psu.se411.lab04.MainClass</mainClass>
        </configuration>
      </plugin>

      <!-- Ex 2: Maven Site Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-site-plugin</artifactId>
        <version>3.21.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-project-info-reports-plugin</artifactId>
        <version>3.9.0</version>
      </plugin>
    </plugins>
  </build>

  <!-- Ex 2.4: extra reports added to the generated site -->
  <reporting>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-project-info-reports-plugin</artifactId>
        <version>3.9.0</version>
        <reportSets>
          <reportSet>
            <reports>
              <report>index</report>
              <report>summary</report>
              <report>licenses</report>
              <report>team</report>
              <report>scm</report>
              <report>issue-management</report>
              <report>dependencies</report>
              <report>plugins</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <reportSets>
          <reportSet>
            <reports>
              <report>javadoc</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>
</project>
